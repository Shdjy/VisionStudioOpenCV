{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "qt-creator-mingw",
            "displayName": "Qt Creator (MinGW 64-bit)",
            "description": "Qt Creator MinGW 6.8.2 / OpenCV 4.9 默认预设配置",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "D:/Qt/6.8.2/mingw_64;D:/opencv4.9/build_mingw"
            }
        },
        {
            "name": "vs-msvc-x64",
            "displayName": "Visual Studio (MSVC x64)",
            "description": "Visual Studio MSVC x64 默认预设配置",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "qt-creator-mingw",
            "configurePreset": "qt-creator-mingw"
        },
        {
            "name": "vs-msvc-x64",
            "configurePreset": "vs-msvc-x64"
        }
    ]
}
