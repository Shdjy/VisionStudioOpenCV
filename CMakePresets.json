{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "qt-creator-mingw",
            "displayName": "Qt Creator (MinGW 6.8.2 64-bit)",
            "description": "Qt Creator MinGW 6.8.2 / OpenCV 4.9 默认预设配置",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/qt6-mingw/Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "D:/Qt/6.8.2/mingw_64;D:/opencv4.9/build_mingw"
            }
        },
        {
            "name": "windows-vs2022",
            "displayName": "Visual Studio 2022 (MSVC x64)",
            "description": "Visual Studio 2022 IDE 默认构建目录",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/x64-Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "qt-creator-mingw",
            "configurePreset": "qt-creator-mingw"
        },
        {
            "name": "windows-vs2022",
            "configurePreset": "windows-vs2022"
        }
    ]
}
